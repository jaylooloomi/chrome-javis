{
  "name": "snapfill",
  "version": "2.0.0",
  "description": "Snapfill — private, on-device AI form filler. Reads a page's form, maps your saved profile to its fields with Gemini Nano (or any OpenAI-compatible endpoint), and fills it in one click.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node build/esbuild.config.mjs",
    "dev": "node build/esbuild.config.mjs --watch"
  },
  "keywords": [
    "chrome-extension",
    "ai-agent",
    "browser-automation",
    "record-replay",
    "page-agent",
    "self-healing"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.8"
  }
}
