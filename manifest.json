{
  "manifest_version": 3,
  "name": "Snapfill — Private AI Form Filler & Autofill",
  "version": "2.0.0",
  "description": "Private, on-device AI form filler. Autofill any web form in one click from your saved profile — your data never leaves your browser.",
  "minimum_chrome_version": "127",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "128": "images/snapfill-128.png"
  },
  "action": {
    "default_title": "Open Snapfill",
    "default_icon": {
      "128": "images/snapfill-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the current form with Snapfill"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
