{
  "manifest_version": 3,
  "name": "Javis — Self-Teaching Browser Agent",
  "version": "2.0.0",
  "description": "Teach Javis a task once; it freezes the run into a skill and replays it with no AI calls.",
  "minimum_chrome_version": "127",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "128": "images/jarvis_pixian_ai.png"
  },
  "action": {
    "default_title": "Open Javis",
    "default_icon": {
      "128": "images/jarvis_pixian_ai.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
